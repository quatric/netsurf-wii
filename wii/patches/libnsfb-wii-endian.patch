+        wii_pending_count = 0;
+        wii_present_retries = WII_PRESENT_RETRIES;
+        wii_present_ticks = now;
+        return;
+    }
+
+    if (wii_present_retries == 0 ||
+            (now - wii_present_ticks) < WII_POLL_INTERVAL_MS)
+        return;
+
+    wii_present_retries--;
+    wii_present_ticks = now;
+    SDL_UpdateRect(screen, 0, 0, 1, 1);
+}
