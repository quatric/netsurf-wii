+static bool wii_controller_event(nsfb_event_t *event)
+{
+    static const u32 masks[] = {
+        WPAD_BUTTON_A, WPAD_BUTTON_B,
+        WPAD_BUTTON_UP, WPAD_BUTTON_DOWN,
+        WPAD_BUTTON_LEFT, WPAD_BUTTON_RIGHT,
+        WPAD_BUTTON_PLUS, WPAD_BUTTON_MINUS,
+        WPAD_BUTTON_1, WPAD_BUTTON_2, WPAD_BUTTON_HOME
+    };
+    static const enum nsfb_key_code_e keys[] = {
+        NSFB_KEY_MOUSE_1, NSFB_KEY_MOUSE_3,
+        NSFB_KEY_UP, NSFB_KEY_DOWN,
+        NSFB_KEY_LEFT, NSFB_KEY_RIGHT,
+        NSFB_KEY_EQUALS, NSFB_KEY_MINUS,
+        NSFB_KEY_PAGEUP, NSFB_KEY_PAGEDOWN, NSFB_KEY_UNKNOWN
+    };
+    u32 current;
+    u32 changed;
+    unsigned int index;
+
+    if (!wii_polled_valid)
+        return false;
+
+    current = wii_polled_buttons;
+    changed = current ^ wii_previous_buttons;
+
+    for (index = 0; index < sizeof(masks) / sizeof(masks[0]); index++) {
+        bool pressed = (current & masks[index]) != 0;
+
+        if ((changed & masks[index]) == 0)
+            continue;
+        wii_previous_buttons ^= masks[index];
+
+        switch (masks[index]) {
+        case WPAD_BUTTON_HOME:
+            /* There is no window manager to deliver a quit request. */
+            if (!pressed)
+                continue;
+            event->type = NSFB_EVENT_CONTROL;
+            event->value.controlcode = NSFB_CONTROL_QUIT;
+            return true;
+
+        case WPAD_BUTTON_PLUS:
+        case WPAD_BUTTON_MINUS:
+            /* Zoom as Ctrl+= and Ctrl+- do, rather than typing a character
+             * into whichever text field has focus. */
+            if (!pressed)
+                continue;
+            wii_queue_key(NSFB_EVENT_KEY_DOWN, NSFB_KEY_LCTRL);
+            wii_queue_key(NSFB_EVENT_KEY_DOWN, keys[index]);
+            wii_queue_key(NSFB_EVENT_KEY_UP, keys[index]);
+            wii_queue_key(NSFB_EVENT_KEY_UP, NSFB_KEY_LCTRL);
+            return wii_dequeue_event(event);
+
+        default:
+            event->type = pressed ? NSFB_EVENT_KEY_DOWN : NSFB_EVENT_KEY_UP;
+            event->value.keycode = keys[index];
+            return true;
+        }
+    }
+    return false;
