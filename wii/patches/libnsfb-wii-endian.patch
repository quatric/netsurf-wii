+/* libogc's USB HID drivers are independent from SDL's Wii backend. Keep a
+ * local queue so one HID report can yield movement, wheel, and button events. */
+#define WII_USB_EVENT_QUEUE_SIZE 16
+static nsfb_event_t wii_usb_events[WII_USB_EVENT_QUEUE_SIZE];
+static unsigned int wii_usb_event_head;
+static unsigned int wii_usb_event_count;
+
+static void wii_usb_queue_event(enum nsfb_event_type_e type,
+        enum nsfb_key_code_e keycode, int x, int y)
+{
+    nsfb_event_t *event;
+    unsigned int tail;
+
+    if (wii_usb_event_count == WII_USB_EVENT_QUEUE_SIZE)
+        return;
+    tail = (wii_usb_event_head + wii_usb_event_count) %
+            WII_USB_EVENT_QUEUE_SIZE;
+    event = &wii_usb_events[tail];
+    event->type = type;
+    if (type == NSFB_EVENT_MOVE_RELATIVE) {
+        event->value.vector.x = x;
+        event->value.vector.y = y;
+        event->value.vector.z = 0;
+    } else {
+        event->value.keycode = keycode;
+    }
+    wii_usb_event_count++;
+}
+
+static bool wii_usb_dequeue_event(nsfb_event_t *event)
+{
+    if (wii_usb_event_count == 0)
+        return false;
+    *event = wii_usb_events[wii_usb_event_head];
+    wii_usb_event_head = (wii_usb_event_head + 1) % WII_USB_EVENT_QUEUE_SIZE;
+    wii_usb_event_count--;
+    return true;
+}
+
+static enum nsfb_key_code_e wii_usb_keycode(u16 symbol)
+{
+    if (symbol <= NSFB_KEY_DELETE)
+        return (enum nsfb_key_code_e)symbol;
+
+    switch (symbol) {
+    case KS_Shift_L: return NSFB_KEY_LSHIFT;
+    case KS_Shift_R: return NSFB_KEY_RSHIFT;
+    case KS_Control_L: return NSFB_KEY_LCTRL;
+    case KS_Control_R: return NSFB_KEY_RCTRL;
+    case KS_Alt_L: return NSFB_KEY_LALT;
+    case KS_Alt_R: return NSFB_KEY_RALT;
+    case KS_Meta_L: return NSFB_KEY_LMETA;
+    case KS_Meta_R: return NSFB_KEY_RMETA;
+    case KS_Caps_Lock: return NSFB_KEY_CAPSLOCK;
+    case KS_Num_Lock: return NSFB_KEY_NUMLOCK;
+    case KS_Home: return NSFB_KEY_HOME;
+    case KS_End: return NSFB_KEY_END;
+    case KS_Prior: return NSFB_KEY_PAGEUP;
+    case KS_Next: return NSFB_KEY_PAGEDOWN;
+    case KS_Up: return NSFB_KEY_UP;
+    case KS_Down: return NSFB_KEY_DOWN;
+    case KS_Left: return NSFB_KEY_LEFT;
+    case KS_Right: return NSFB_KEY_RIGHT;
+    case KS_Insert: return NSFB_KEY_INSERT;
+    case KS_F1: return NSFB_KEY_F1;
+    case KS_F2: return NSFB_KEY_F2;
+    case KS_F3: return NSFB_KEY_F3;
+    case KS_F4: return NSFB_KEY_F4;
+    case KS_F5: return NSFB_KEY_F5;
+    case KS_F6: return NSFB_KEY_F6;
+    case KS_F7: return NSFB_KEY_F7;
+    case KS_F8: return NSFB_KEY_F8;
+    case KS_F9: return NSFB_KEY_F9;
+    case KS_F10: return NSFB_KEY_F10;
+    case KS_F11: return NSFB_KEY_F11;
+    case KS_F12: return NSFB_KEY_F12;
+    default: return NSFB_KEY_UNKNOWN;
+    }
+}
+
+static bool wii_usb_input_event(nsfb_event_t *event)
+{
+    keyboard_event keyboard;
+    mouse_event mouse;
+
+    if (wii_usb_dequeue_event(event))
+        return true;
+
+    if (wii_usb_keyboard_ready && KEYBOARD_GetEvent(&keyboard)) {
+        enum nsfb_key_code_e keycode = wii_usb_keycode(keyboard.symbol);
+
+        if ((keyboard.type == KEYBOARD_PRESSED ||
+                keyboard.type == KEYBOARD_RELEASED) &&
+                keycode != NSFB_KEY_UNKNOWN) {
+            event->type = keyboard.type == KEYBOARD_PRESSED ?
+                    NSFB_EVENT_KEY_DOWN : NSFB_EVENT_KEY_UP;
+            event->value.keycode = keycode;
+            return true;
+        }
+    }
+
+    if (!wii_usb_mouse_ready || !MOUSE_GetEvent(&mouse))
+        return false;
+
+    if (mouse.rx != 0 || mouse.ry != 0)
+        wii_usb_queue_event(NSFB_EVENT_MOVE_RELATIVE, NSFB_KEY_UNKNOWN,
+                mouse.rx, mouse.ry);
+    if (mouse.rz > 0)
+        wii_usb_queue_event(NSFB_EVENT_KEY_DOWN, NSFB_KEY_MOUSE_4, 0, 0);
+    else if (mouse.rz < 0)
+        wii_usb_queue_event(NSFB_EVENT_KEY_DOWN, NSFB_KEY_MOUSE_5, 0, 0);
+
+    {
+        static const u8 button_masks[] = { 1, 4, 2 };
+        static const enum nsfb_key_code_e button_keys[] = {
+            NSFB_KEY_MOUSE_1, NSFB_KEY_MOUSE_2, NSFB_KEY_MOUSE_3
+        };
+        u8 changed = mouse.button ^ wii_usb_mouse_buttons;
+        unsigned int index;
+
+        for (index = 0; index < sizeof(button_masks) / sizeof(button_masks[0]);
+                index++) {
+            if ((changed & button_masks[index]) != 0) {
+                wii_usb_queue_event((mouse.button & button_masks[index]) != 0 ?
+                        NSFB_EVENT_KEY_DOWN : NSFB_EVENT_KEY_UP,
+                        button_keys[index], 0, 0);
+            }
+        }
+        wii_usb_mouse_buttons = mouse.button;
+    }
+
+    return wii_usb_dequeue_event(event);
+}
+
+static u32 wii_canonical_buttons(u32 pressed)
+{
+    if (pressed & (WPAD_CLASSIC_BUTTON_ZR | WPAD_CLASSIC_BUTTON_PLUS))
+        pressed |= WPAD_BUTTON_PLUS;
+    if (pressed & (WPAD_CLASSIC_BUTTON_ZL | WPAD_CLASSIC_BUTTON_MINUS))
+        pressed |= WPAD_BUTTON_MINUS;
+    if (pressed & WPAD_CLASSIC_BUTTON_A)
+        pressed |= WPAD_BUTTON_A;
+    if (pressed & WPAD_CLASSIC_BUTTON_B)
+        pressed |= WPAD_BUTTON_B;
+    if (pressed & WPAD_CLASSIC_BUTTON_X)
+        pressed |= WPAD_BUTTON_2;
+    if (pressed & WPAD_CLASSIC_BUTTON_Y)
+        pressed |= WPAD_BUTTON_1;
+    if (pressed & WPAD_CLASSIC_BUTTON_HOME)
+        pressed |= WPAD_BUTTON_HOME;
+    if (pressed & WPAD_CLASSIC_BUTTON_UP)
+        pressed |= WPAD_BUTTON_UP;
+    if (pressed & WPAD_CLASSIC_BUTTON_DOWN)
+        pressed |= WPAD_BUTTON_DOWN;
+    if (pressed & WPAD_CLASSIC_BUTTON_LEFT)
+        pressed |= WPAD_BUTTON_LEFT;
+    if (pressed & WPAD_CLASSIC_BUTTON_RIGHT)
+        pressed |= WPAD_BUTTON_RIGHT;
+    return pressed;
+}
+
+static u32 wii_controller_buttons(void)
+{
+    u32 pressed = 0;
+    u32 gcpressed = 0;
+    unsigned int channel;
+
+    WUPC_UpdateButtonStats();
+    for (channel = 0; channel < 4; channel++)
+        pressed |= WUPC_ButtonsHeld(channel);
+    pressed = wii_canonical_buttons(pressed);
+
+    if (pressed != 0)
+        return pressed;
+
+    for (channel = 0; channel < 4; channel++)
+        pressed |= WPAD_ButtonsHeld(channel);
+    pressed = wii_canonical_buttons(pressed);
+
+    if (pressed != 0)
+        return pressed;
+
+    if (PAD_ScanPads() > PAD_ERR_NONE) {
+        for (channel = 0; channel < 4; channel++)
+            gcpressed |= PAD_ButtonsHeld(channel);
+        if (gcpressed & PAD_TRIGGER_R)
+            pressed |= WPAD_BUTTON_PLUS;
+        if (gcpressed & PAD_TRIGGER_L)
+            pressed |= WPAD_BUTTON_MINUS;
+        if (gcpressed & PAD_BUTTON_A)
+            pressed |= WPAD_BUTTON_A;
+        if (gcpressed & PAD_BUTTON_B)
+            pressed |= WPAD_BUTTON_B;
+        if (gcpressed & PAD_BUTTON_X)
+            pressed |= WPAD_BUTTON_2;
+        if (gcpressed & PAD_BUTTON_Y)
+            pressed |= WPAD_BUTTON_1;
+        if (gcpressed & PAD_BUTTON_MENU)
+            pressed |= WPAD_BUTTON_HOME;
+        if (gcpressed & PAD_BUTTON_UP)
+            pressed |= WPAD_BUTTON_UP;
+        if (gcpressed & PAD_BUTTON_DOWN)
+            pressed |= WPAD_BUTTON_DOWN;
+        if (gcpressed & PAD_BUTTON_LEFT)
+            pressed |= WPAD_BUTTON_LEFT;
+        if (gcpressed & PAD_BUTTON_RIGHT)
+            pressed |= WPAD_BUTTON_RIGHT;
+    }
+    return pressed;
+}
+
+static bool wii_controller_event(nsfb_event_t *event)
+{
+    static const u32 masks[] = {
+        WPAD_BUTTON_A, WPAD_BUTTON_B,
+        WPAD_BUTTON_UP, WPAD_BUTTON_DOWN,
+        WPAD_BUTTON_LEFT, WPAD_BUTTON_RIGHT,
+        WPAD_BUTTON_PLUS, WPAD_BUTTON_MINUS,
+        WPAD_BUTTON_1, WPAD_BUTTON_2, WPAD_BUTTON_HOME
+    };
+    static const enum nsfb_key_code_e keys[] = {
+        NSFB_KEY_MOUSE_1, NSFB_KEY_MOUSE_3,
+        NSFB_KEY_UP, NSFB_KEY_DOWN,
+        NSFB_KEY_LEFT, NSFB_KEY_RIGHT,
+        NSFB_KEY_PLUS, NSFB_KEY_MINUS,
+        NSFB_KEY_PAGEUP, NSFB_KEY_PAGEDOWN, NSFB_KEY_ESCAPE
+    };
+    u32 current = wii_controller_buttons();
+    u32 changed = current ^ wii_previous_buttons;
+    unsigned int index;
+
+    for (index = 0; index < sizeof(masks) / sizeof(masks[0]); index++) {
+        if ((changed & masks[index]) != 0) {
+            event->type = (current & masks[index]) != 0 ?
+                    NSFB_EVENT_KEY_DOWN : NSFB_EVENT_KEY_UP;
+            event->value.keycode = keys[index];
+            wii_previous_buttons ^= masks[index];
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool wii_pointer_event(nsfb_t *nsfb, nsfb_event_t *event)
+{
+    unsigned int channel;
+
+    for (channel = 0; channel < 4; channel++) {
+        ir_t ir;
+        int x;
+        int y;
+
+        WPAD_IR(channel, &ir);
+        if (!ir.valid)
+            continue;
+
+        x = (int)ir.x;
+        y = (int)ir.y;
+        if (x < 0)
+            x = 0;
+        else if (x >= nsfb->width)
+            x = nsfb->width - 1;
+        if (y < 0)
+            y = 0;
+        else if (y >= nsfb->height)
+            y = nsfb->height - 1;
+
+        if (x == wii_previous_pointer_x && y == wii_previous_pointer_y)
+            return false;
+
+        wii_previous_pointer_x = x;
+        wii_previous_pointer_y = y;
+        event->type = NSFB_EVENT_MOVE_ABSOLUTE;
+        event->value.vector.x = x;
+        event->value.vector.y = y;
+        event->value.vector.z = 0;
+        return true;
+    }
+
+    return false;
+}
