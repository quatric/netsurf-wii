+/**
+ * Refresh the cached controller state, at most once every
+ * WII_POLL_INTERVAL_MS.
+ *
+ * WPAD_ScanPads() is what keeps SDL-wii's own pointer and mouse button
+ * handling supplied with fresh data, so it has to happen here whether or not
+ * this file has any use for the result. It is rate limited because
+ * WUPC_UpdateButtonStats() and especially PAD_ScanPads(), which blocks on an
+ * SI transfer, are far too expensive to run once per event loop iteration.
+ *
+ * \return true when there may be an unreported button change to emit.
+ */
+static bool wii_poll_controllers(void)
+{
+    u32 now = SDL_GetTicks();
+
+    if (wii_polled_valid &&
+        (now - wii_last_poll_ticks) < WII_POLL_INTERVAL_MS) {
+        /* Report the cached state so a change spanning several buttons is
+         * still drained one event per call, but do no hardware access. */
+        return wii_polled_buttons != wii_previous_buttons;
+    }
+
+    wii_last_poll_ticks = now;
+
+    if (wii_pointer_joystick != NULL) {
+        SDL_JoystickUpdate();
+    }
+    WPAD_ScanPads();
+
+    wii_polled_buttons = wii_controller_buttons();
+    wii_polled_valid = true;
+
+    return wii_polled_buttons != wii_previous_buttons;
+}
