+/* The first stick of a GameCube pad, Classic Controller or Wii U Pro
+ * Controller moves the pointer, since only the Wii Remote can aim one; the
+ * second stick, or a Nunchuk's, scrolls. */
+static void wii_stick_input(void)
+{
+    float px = 0.0f;
+    float py = 0.0f;
+    float sy = 0.0f;
+    float x;
+    float y;
+    float k;
+    const char *source;
+    int dx;
+    int dy;
+
+    /* One device per stick (the strongest); a Nunchuk's stick scrolls. */
+    if (INPUT_StickRaw(INPUT_STICK_LEFT, &x, &y, &source) > 0.0f) {
+        k = wii_stick_scale(source, INPUT_STICK_LEFT);
+        if (strcmp(source, "Nunchuk") == 0) {
+            sy = -y * k;
+        } else {
+            px = x * k;
+            py = -y * k;
+        }
+    }
+    if (INPUT_StickRaw(INPUT_STICK_RIGHT, &x, &y, &source) > 0.0f) {
+        k = wii_stick_scale(source, INPUT_STICK_RIGHT);
+        sy += -y * k;
+    }
+
+    px = wii_stick_curve(px);
+    py = wii_stick_curve(py);
+    sy = wii_stick_curve(sy);
+
+    /* Carry fractions of a pixel between polls so slow movement still moves. */
+    wii_stick_dx = (px == 0.0f) ? 0.0f :
+            wii_stick_dx + px * WII_STICK_POINTER_SPEED;
+    wii_stick_dy = (py == 0.0f) ? 0.0f :
+            wii_stick_dy + py * WII_STICK_POINTER_SPEED;
+    dx = (int)wii_stick_dx;
+    dy = (int)wii_stick_dy;
+    if (dx != 0 || dy != 0) {
+        wii_stick_dx -= dx;
+        wii_stick_dy -= dy;
+        wii_queue_event(NSFB_EVENT_MOVE_RELATIVE, NSFB_KEY_UNKNOWN, dx, dy);
+    }
+
+    wii_stick_scroll += sy * WII_STICK_SCROLL_SPEED;
+    if (sy == 0.0f) {
+        wii_stick_scroll = 0.0f;
+    } else if (wii_stick_scroll <= -1.0f) {
+        wii_stick_scroll += 1.0f;
+        wii_queue_key(NSFB_EVENT_KEY_DOWN, NSFB_KEY_MOUSE_4);
+        wii_queue_key(NSFB_EVENT_KEY_UP, NSFB_KEY_MOUSE_4);
+    } else if (wii_stick_scroll >= 1.0f) {
+        wii_stick_scroll -= 1.0f;
+        wii_queue_key(NSFB_EVENT_KEY_DOWN, NSFB_KEY_MOUSE_5);
+        wii_queue_key(NSFB_EVENT_KEY_UP, NSFB_KEY_MOUSE_5);
+    }
+}
