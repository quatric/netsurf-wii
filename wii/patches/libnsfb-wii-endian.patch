+/* libogc's USB HID drivers are independent from SDL's Wii backend. Keep a
+ * local queue so one HID report can yield movement, wheel, and button events. */
+#define WII_USB_EVENT_QUEUE_SIZE 16
+static nsfb_event_t wii_usb_events[WII_USB_EVENT_QUEUE_SIZE];
+static unsigned int wii_usb_event_head;
+static unsigned int wii_usb_event_count;
+
+static void wii_usb_queue_event(enum nsfb_event_type_e type,
+        enum nsfb_key_code_e keycode, int x, int y)
+{
+    nsfb_event_t *event;
+    unsigned int tail;
+
+    if (wii_usb_event_count == WII_USB_EVENT_QUEUE_SIZE)
+        return;
+    tail = (wii_usb_event_head + wii_usb_event_count) %
+            WII_USB_EVENT_QUEUE_SIZE;
+    event = &wii_usb_events[tail];
+    event->type = type;
+    if (type == NSFB_EVENT_MOVE_RELATIVE) {
+        event->value.vector.x = x;
+        event->value.vector.y = y;
+        event->value.vector.z = 0;
+    } else {
+        event->value.keycode = keycode;
+    }
+    wii_usb_event_count++;
+}
+
+static bool wii_usb_dequeue_event(nsfb_event_t *event)
+{
+    if (wii_usb_event_count == 0)
+        return false;
+    *event = wii_usb_events[wii_usb_event_head];
+    wii_usb_event_head = (wii_usb_event_head + 1) % WII_USB_EVENT_QUEUE_SIZE;
+    wii_usb_event_count--;
+    return true;
+}
