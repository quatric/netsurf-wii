+static void wii_queue_rect(SDL_Surface *screen, int x0, int y0, int x1, int y1)
+{
+    SDL_Rect *rect;
+
+    /* SDL_UpdateRect() takes an empty size to mean the whole screen and
+     * drops a rectangle that crosses the edge, so clip here instead. */
+    if (x0 < 0)
+        x0 = 0;
+    if (y0 < 0)
+        y0 = 0;
+    if (x1 > screen->w)
+        x1 = screen->w;
+    if (y1 > screen->h)
+        y1 = screen->h;
+    if (x1 <= x0 || y1 <= y0)
+        return;
+
+    if (wii_pending_count == WII_PENDING_RECTS) {
+        int index;
+
+        for (index = 0; index < wii_pending_count; index++) {
+            rect = &wii_pending_rects[index];
+            if (rect->x < x0)
+                x0 = rect->x;
+            if (rect->y < y0)
+                y0 = rect->y;
+            if (rect->x + rect->w > x1)
+                x1 = rect->x + rect->w;
+            if (rect->y + rect->h > y1)
+                y1 = rect->y + rect->h;
+        }
+        wii_pending_count = 0;
+    }
+
+    rect = &wii_pending_rects[wii_pending_count++];
+    rect->x = x0;
+    rect->y = y0;
+    rect->w = x1 - x0;
+    rect->h = y1 - y0;
+}
