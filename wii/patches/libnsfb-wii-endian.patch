+/* SDL-wii uploads the 32bpp shadow surface into a GX_TF_RGBA8 texture with
+ * UpdateRect_32()/Set_RGBAPixel(), which read the four bytes of a pixel as
+ * alpha, red, green, blue in that order -- i.e. 0xAARRGGBB once loaded as a
+ * big endian word. The generic big endian formula below stores 0xBBGGRR00
+ * instead, which drops blue entirely (hence an overall yellow cast) and
+ * rotates the remaining channels. */
+
+static inline nsfb_colour_t pixel_to_colour(UNUSED nsfb_t *nsfb, uint32_t pixel)
+{
+        /* 0xAARRGGBB -> 0xAABBGGRR */
+        return 0xFF000000U |
+               ((pixel & 0x000000FFU) << 16) |
+                (pixel & 0x0000FF00U) |
+               ((pixel & 0x00FF0000U) >> 16);
+}
+
+static inline uint32_t colour_to_pixel(UNUSED nsfb_t *nsfb, nsfb_colour_t c)
+{
+        /* 0xAABBGGRR -> 0xAARRGGBB. The alpha byte is forced opaque: it ends
+         * up in the texture's alpha channel, and SDL-wii's GX blend setup
+         * would otherwise let a zero alpha erase the pixel. */
+        return 0xFF000000U |
+               ((c & 0x000000FFU) << 16) |
+                (c & 0x0000FF00U) |
+               ((c & 0x00FF0000U) >> 16);
+}
