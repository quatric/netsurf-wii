+/* Remove the dead zone and square the remainder for finer control near the
+ * center; v and the result are in -1..1. */
+static float wii_stick_curve(float v)
+{
+    float magnitude = fabsf(v);
+
+    if (magnitude <= WII_STICK_DEADZONE)
+        return 0.0f;
+    if (magnitude > 1.0f)
+        magnitude = 1.0f;
+    magnitude = (magnitude - WII_STICK_DEADZONE) / (1.0f - WII_STICK_DEADZONE);
+    return (v < 0.0f) ? -(magnitude * magnitude) : magnitude * magnitude;
+}
+
+/* Rescale an unclamped libinput-wii stick (its own ranges, y up) to the
+ * divisors this file has always used; callers flip y to grow downward and
+ * wii_stick_curve() clamps each axis, as before. */
+static float wii_stick_scale(const char *source, int which)
+{
+    if (strcmp(source, "GameCube") == 0)
+        return (which == INPUT_STICK_LEFT) ? 70.0f / 80.0f : 60.0f / 80.0f;
+    if (strcmp(source, "Wii U Pro") == 0)
+        return 900.0f / 1024.0f;
+    return 1.0f;
+}
